{
  "name": "password-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade Zero-Knowledge Password Manager",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "npm.cmd run dev --workspace=@pwm/api & npm.cmd run dev --workspace=@pwm/web",
    "dev:api": "npm.cmd run dev --workspace=@pwm/api",
    "dev:web": "npm.cmd run dev --workspace=@pwm/web",
    "build": "npm.cmd run build --workspace=@pwm/shared && npm.cmd run build --workspace=@pwm/api && npm.cmd run build --workspace=@pwm/web",
    "test": "npm.cmd run test --workspace=@pwm/api",
    "prisma:generate": "npx.cmd prisma generate",
    "prisma:migrate": "npx.cmd prisma migrate dev",
    "prisma:push": "npx.cmd prisma db push"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

