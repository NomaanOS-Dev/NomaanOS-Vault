# =====================================================================
# NomaanOS Vault - Production Environment Configuration
# =====================================================================
# Copy this file to .env.production or pass as environment variables in Docker
# Generate cryptographic secrets using: openssl rand -base64 32

NODE_ENV=production
PORT=3001
HTTP_PORT=80

# ---------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ---------------------------------------------------------------------
POSTGRES_USER=vaultadmin
POSTGRES_PASSWORD=replace_with_a_very_strong_random_database_password
POSTGRES_DB=nomaanos_vault
DATABASE_URL=postgresql://vaultadmin:replace_with_a_very_strong_random_database_password@postgres:5432/nomaanos_vault?schema=public

# ---------------------------------------------------------------------
# Application Cryptographic Secrets (MANDATORY IN PRODUCTION)
# ---------------------------------------------------------------------
# Minimum 32-character high-entropy secret for signing authentication JWT tokens
JWT_SECRET=replace_with_openssl_rand_base64_32_secret

# Minimum 32-character high-entropy secret for signing session cookies
SESSION_SECRET=replace_with_openssl_rand_base64_32_session_secret

# ---------------------------------------------------------------------
# Host, Domain & CORS Configuration
# ---------------------------------------------------------------------
# Public canonical URL of your deployed application
APP_BASE_URL=https://vault.yourdomain.com

# Permitted Origin for cross-origin requests
CORS_ORIGIN=https://vault.yourdomain.com

# ---------------------------------------------------------------------
# SMTP Transactional Email Configuration
# (Required for email verification & private Master Password hints)
# ---------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=replace_with_your_smtp_provider_api_key
SMTP_FROM="NomaanOS Vault <no-reply@vault.yourdomain.com>"

# ---------------------------------------------------------------------
# Google OAuth 2.0 (Optional - For Google Sign-In)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
